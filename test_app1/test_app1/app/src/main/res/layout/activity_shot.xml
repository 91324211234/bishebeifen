<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShotActivity">

    <Button
        android:id="@+id/camera_capture_button"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/btn_photo"
        android:elevation="2dp"
        android:fontFamily="sans-serif-condensed"
        android:scaleType="fitCenter"
        android:text="点击\n拍照"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/flash_button2"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="250dp"
        android:layout_marginBottom="95dp"
        android:background="@drawable/btn_flash"
        android:drawableTop="@drawable/ic_baseline_flash_on_24"
        android:elevation="2dp"
        android:fontFamily="sans-serif-condensed"
        android:paddingTop="25dp"
        android:scaleType="fitCenter"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:onClick="flash"/>

    <Button
        android:id="@+id/flash_button"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="250dp"
        android:layout_marginBottom="95dp"
        android:background="@drawable/btn_flash"
        android:elevation="2dp"
        android:onClick="photo"

        android:scaleType="fitCenter"
        android:text="相册"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seekBar"
        style="?attr/seekBarStyle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:elevation="2dp"
        android:max="100"
        android:maxHeight="7dip"
        android:minHeight="7dip"
        android:progress="0"
        android:progressBackgroundTint="#FF5722"
        android:progressDrawable="@drawable/seekbar"
        android:rotation="0"
        android:rotationX="0"
        android:thumb="@drawable/ic_baseline_camera_24"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/camera_capture_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

    </androidx.camera.view.PreviewView>

</androidx.constraintlayout.widget.ConstraintLayout>